DATABASE_URL="postgresql://usuario:senha@ep-seu-host.aws.neon.tech/cardapio?sslmode=require"

# API
PORT=3000

# Neon Auth: issuer/audience do JWT de sessão (host "Domain" mostrado no console da Neon, ex.: https://projeto.neonauth.sa-east-1.aws.neon.tech)
NEON_AUTH_ISSUER=

# Secret do JWT HS256 emitido pela API no POST /auth/exchange (gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
APP_JWT_SECRET=

# Origin do front, usada nas chamadas do back para a Neon Auth (criar admins)
FRONT_URL=http://localhost:4200

# CORS: origens adicionais permitidas (separadas por vírgula) além da FRONT_URL.
# Depois do deploy no Vercel, coloque aqui o domínio real (ex.: https://www.seudominio.com.br).
# A origem nunca é usada como autorização — só defesa em profundidade.
CORS_ORIGINS=

# Desativa o rate limit global (TRUE só para smokes locais/testes; nunca em produção).
THROTTLE_DISABLED=false


# Cloudflare R2 (galeria) — OPCIONAL por enquanto: o seed usa URL do Pexels direto.
# Quando ativar o R2, preencha e altere o seed para gravar a URL pública do bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Pexels (fonte das imagens do seed da galeria) — https://www.pexels.com/api/
PEXELS_API_KEY=

# WhatsApp (Meta Cloud API) — notificações de novo pedido ao dono (F8.6).
# OPCIONAL: sem env, `configured` = false e nenhum envio acontece (o toggle
# `notifWhatsapp` da loja também precisa estar ligado). Nunca logamos o token.
# App na Meta: https://developers.facebook.com/apps → seu app → WhatsApp → API Setup.
# O número de TESTE envia para até 5 destinatários com o template "hello_world"
# (en_US) — serve para validar o `npm run testar:whatsapp`. Produção: Business
# Account + verificação + número real + template aprovado (ex.: pedido_novo, com
# {1} lanchonete, {2} número, {3} total, {4} tipo de entrega, {5} pagamento).
WA_GRAPH_TOKEN=
WA_PHONE_NUMBER_ID=
WA_GRAPH_VERSION=v21.0
WA_TEMPLATE_PEDIDO_NOVO=hello_world
WA_TEMPLATE_LANG=en_US
# Destinatário padrão do npm run testar:whatsapp (overridável por argumento).
WA_TEST_RECIPIENT=5527998927442
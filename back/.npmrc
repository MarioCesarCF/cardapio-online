# OBRIGATÓRIO: sem isto o `npm install` do back quebra ao resolver os peers do
# vitest ("Cannot read properties of null (reading 'edgesOut')"). Nunca remover.
legacy-peer-deps=true

# Cooldown de supply chain: npm só resolve versões publicadas há 7+ dias, o que
# corta pacotes recém-publicados com malware (typosquat/comprometimento).
# Requer npm >= 11.10; em versões antigas a chave é apenas ignorada (com aviso).
# As versões do package-lock.json estão travadas, então instalar pelo lock
# continua instalando exatamente o que está travado.
min-release-age=7
